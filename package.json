    "eas:submit:ios": "npx eas-cli submit --platform ios --profile production --latest",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
