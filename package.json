{
  "name": "blind-box-closet",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start --lan --clear",
    "ios": "expo start --ios --clear",
    "android": "expo start --android --clear",
    "web": "expo start --web --clear",
    "server:dev": "npm --prefix server run dev",
