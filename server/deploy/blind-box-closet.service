[Unit]
Description=Blind Box Closet API
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/blind-box-closet/server
EnvironmentFile=/opt/blind-box-closet/server/.env
ExecStart=/usr/bin/npx tsx src/index.ts
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
